# Optional research / enrichment providers (Phase 2B+)
# Copy to .env and fill values. Never commit secrets.

# Public web research uses httpx only — no key required for Phase 2A.
# NORTHSTAR_RESEARCH_USER_AGENT=NorthStarAI-Research/2A

# ZoomInfo — not connected in Phase 2A
# ZOOMINFO_API_KEY=
# ZOOMINFO_API_BASE=

# --- Google Workspace / Gmail OAuth (email send) ---
# Create an OAuth 2.0 Web application client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8007/api/email/google/callback

# Fernet key for encrypting OAuth tokens at rest (NOT the Google client secret).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NORTHSTAR_OAUTH_TOKEN_KEY=

# Where the browser returns after OAuth (Vite dev server by default)
NORTHSTAR_FRONTEND_ORIGIN=http://localhost:5174
NORTHSTAR_API_PUBLIC_BASE=http://127.0.0.1:8007

# --- Staff authentication ---
# Keep NORTHSTAR_AUTH_ENFORCE disabled in this example. Never commit a live =1.
# NORTHSTAR_AUTH_ENFORCE=0
#
# Local enforced startup uses gitignored backend/.env.auth (one line:
# NORTHSTAR_AUTH_ENFORCE=1). Do not put the flag in backend/.env.
# Never place NORTHSTAR_ALLOW_ADMIN_BOOTSTRAP or NORTHSTAR_BOOTSTRAP_PASSWORD
# in persistent env files. Set them only for a one-time bootstrap CLI run.
#
# Start from backend/:
#   .\.venv\Scripts\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8007 --env-file .env.auth
# Rollback: clear the enforcement flag, then start without --env-file .env.auth.
#   .\.venv\Scripts\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8007
#
# One-time bootstrap CLI (never commit a password).
# NORTHSTAR_ALLOW_ADMIN_BOOTSTRAP=1 is required by the CLI and library.
# Live northstar.db also requires typing the exact resolved database path.
# NORTHSTAR_ALLOW_ADMIN_BOOTSTRAP=1
# NORTHSTAR_BOOTSTRAP_PASSWORD=   # optional; popped after read; prefer getpass
